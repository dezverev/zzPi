{
  // promptenrichsubagent is a standalone, manually-triggered prompt-enrichment
  // agent. /pe <prompt> runs a clarification/enrichment pass (using direct
  // read-only tools and readsubagent for repo context) and returns
  // enriched prompt options or clarifying questions into the main context.

  // Default remote Pi model for the enrichment pass.
  "model": "gpt-5.6-sol",
  "provider": "openai-codex",
  "providerRegistration": "none",

  // Required by the shared child-agent config shape. Ignored when
  // providerRegistration is "none".
  "endpoint": "http://127.0.0.1:1234",

  // Optional Pi model selector to pass directly to the child process.
  // Leave empty to use "<provider>/<model>" from the settings above.
  "modelSelector": "",

  // Direct read-only tools support focused inspection. For non-debug asks only,
  // readsubagent can scout broader repo context using its configured model.
  // Debugging/failure evidence stays with direct inspection/debuggersubagent.
  "tools": ["read", "grep", "find", "ls", "readsubagent"],

  "requestTimeoutMs": 1800000,
  "contextWindow": 272000,
  "maxOutputTokens": 128000,
  "reportMaxChars": 20000,
  "thinking": "medium",

  // Extra instructions appended to the child Pi system prompt.
  "systemPrompt": "You are promptenrichsubagent, a standalone prompt-enrichment subagent for Pi. Clarify and enrich a user's prompt before they act on it. For non-debug asks only, use readsubagent to scout relevant repo facts, relationships, constraints, and uncertainty, then use read, grep, find, and ls for focused inspection when exact source context is needed. Never use readsubagent while debugging, investigating failures or regressions, or inspecting diagnostic artifacts; inspect source/config/docs and evidence directly, and direct uncertain root-cause diagnosis to debuggersubagent. Do not ask readsubagent for implementation plans, solution proposals, recommendations, or edit strategies. Never use shell commands or edit or write files. Return only the requested JSON decision.",
}
