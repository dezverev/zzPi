{
  // Authoritative packaged model options shared by every zz subagent.
  // Adjacent agent configs supply operational policy and fallback defaults only.
  "version": 1,
  "modelOptions": {
    "gpt-5.6-sol-medium": {
      "label": "GPT-5.6 Sol medium (openai-codex)",
      "provider": "openai-codex",
      "providerRegistration": "none",
      "model": "gpt-5.6-sol",
      "contextWindow": 272000,
      "maxOutputTokens": 128000,
      "thinking": "medium"
    },
    "gpt-5.6-sol-medium-zz-codex-proxy": {
      "label": "GPT-5.6 Sol medium (zz-codex-proxy)",
      "provider": "zz-codex-proxy",
      "providerRegistration": "none",
      "model": "gpt-5.6-sol",
      "contextWindow": 272000,
      "maxOutputTokens": 128000,
      "thinking": "medium"
    },
    "gpt-5.3-codex-spark": {
      "label": "GPT-5.3 Codex Spark high (openai-codex)",
      "provider": "openai-codex",
      "providerRegistration": "none",
      "model": "gpt-5.3-codex-spark",
      "contextWindow": 128000,
      "maxOutputTokens": 128000,
      "thinking": "high"
    },
    "qwen3p7-plus": {
      "label": "Qwen 3.7 Plus (fireworks)",
      "provider": "fireworks",
      "providerRegistration": "none",
      "model": "accounts/fireworks/models/qwen3p7-plus",
      "contextWindow": 262144,
      "maxOutputTokens": 32768,
      "thinking": "high"
    },
    "qwen-35b-a3b": {
      "label": "Qwen 3.6 35B A3B via local OpenAI-compatible endpoint",
      "provider": "zz-agent-local",
      "providerRegistration": "openai-compatible",
      "model": "qwen/qwen3.6-35b-a3b",
      "endpoint": "http://127.0.0.1:1234",
      "contextWindow": 127000,
      "maxOutputTokens": 32768,
      "thinking": "off"
    }
  }
}
