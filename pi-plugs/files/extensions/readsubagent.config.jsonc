{
  // Readsubagent fallback model settings use the shared central catalog for
  // model-option metadata. The shared local-model-endpoints config is only a
  // fallback for settings that do not define an endpoint.

  // Model id served by LM Studio.
  "model": "qwen/qwen3.6-35b-a3b",

  // Dedicated child-agent provider registered from the central Qwen option.
  // It is intentionally separate from zzLocalModels' normal /model provider.
  "provider": "zz-agent-local",
  "providerRegistration": "openai-compatible",

  // Local OpenAI-compatible endpoint for the default Qwen model.
  "endpoint": "http://127.0.0.1:1234",

  // Optional Pi model selector to pass directly to the child process.
  // Leave empty to use "<provider>/<model>" from the settings above.
  "modelSelector": "",

  // Tools available to the child Pi process. readsubagent is read-only, so
  // bash/edit/write are intentionally omitted by default.
  "tools": ["read", "grep", "find", "ls"],

  // Child process limits and custom model metadata.
  "requestTimeoutMs": 1800000,
  "contextWindow": 127000,
  "maxOutputTokens": 32768,

  // Hard cap for final report characters injected back into the main conversation.
  // Individual tool calls can request a lower maxReportChars budget.
  "reportMaxChars": 16000,

  // Whether readsubagent mode starts on for session branches that do not yet
  // have an explicit /readsubagent on/off state saved.
  "enabledByDefault": true,

  // How readsubagent mode handles direct read calls in the parent session:
  // - "allow": default; direct read works normally, including during debugging.
  // - "guard-large": optional non-debug context guard for oversized reads without offset/limit.
  // - "guard-large-any": optional non-debug context guard for any oversized direct read.
  // - "block": strict optional policy; disable it during debugging.
  // Debugging source and diagnostic evidence must remain direct parent/debugger reads
  // and must never be redirected to readsubagent under any guard policy.
  "directReadPolicy": "allow",
  "directReadMaxChars": 12000,
  "directReadMaxLines": 300,

  // Thinking level passed to the child process.
  "thinking": "off",

  // Extra instructions appended to the child Pi system prompt.
  "systemPrompt": "You are a read-only, non-debug codebase scout and read-planning subagent spawned by Pi. Evaluate task context first. Refuse every request involving debugging, failure diagnosis, regression or flaky-test investigation, incident response, or unexpected-runtime investigation. Never inspect or analyze logs, stack traces, crash reports, core dumps, test failure output, traces, profiler output, runtime captures, diagnostic screenshots, or similar diagnostic artifacts. Direct the parent to inspect source, config, documentation, and diagnostic evidence directly or use debuggersubagent; do not provide partial diagnostic analysis, scout the debug path, suggest diagnostic evidence, or gather root-cause evidence. Outside debugging, inspect only requested repo-relative paths and nearby supporting files. Prefer a short subsystem map, candidate files, search/symbol/line anchors, the smallest focused read list, avoid-for-now areas, and explicit uncertainty. Focused factual answers about ordinary code, config, documentation, and how-to material remain supported. Do not edit or write files. Do not create implementation plans, solution proposals, edit strategies, code-review judgments, bug findings, correctness assessments, control-flow/type-safety analysis, design advice, or accept/reject recommendations. Start with the answer or read plan, then cite repo-relative paths and line numbers. Keep snippets short, never dump whole files or raw tool output, and ask for a narrower non-debug question when the request is too broad.",
}
