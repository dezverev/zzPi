// Source of truth for the dependency-aware zzHostWebsite pi plug installer.
// Paths are relative to this .pi directory.
{
  "schemaVersion": 1,
  "commonFiles": [
    "docs/zzpi-customization.md"
  ],
  "plugins": [
    {
      "id": "zz-plug-manager",
      "title": "zz plug manager",
      "description": "Internal command extension that installs, removes, updates, and dependency-resolves this repo-local pi plug bundle from inside pi.",
      "entry": "extensions/zz-plug-manager.ts",
      "internal": true,
      "pluginDeps": [
        "right-overlay-tiler",
        "zz-subagent-runtime",
        "zz-codex-proxy"
      ],
      "fileDeps": [
        "extensions/zz-plug-manager.config.jsonc",
        "extensions/lib/custom-plug-loader.ts",
        "extensions/lib/custom-plug-activation.ts",
        "extensions/lib/custom-plug-adapter.ts",
        "extensions/lib/custom-plug-module-loader.ts",
        "extensions/lib/custom-plug-types.ts"
      ],
      "configFiles": [
        "extensions/zz-plug-manager.config.jsonc"
      ],
      "tags": [
        "manager",
        "internal"
      ]
    },
    {
      "id": "right-overlay-tiler",
      "title": "Right overlay tiler",
      "description": "Internal host for right-side overlay panes used by status/context/history extensions.",
      "entry": "extensions/00-right-overlay-tiler.ts",
      "internal": true,
      "pluginDeps": [],
      "fileDeps": [
        "extensions/right-overlay-tiler.config.jsonc",
        "extensions/lib/right-overlay-tiler.ts"
      ],
      "configFiles": [
        "extensions/right-overlay-tiler.config.jsonc"
      ],
      "tags": [
        "ui",
        "overlay",
        "internal"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "zz-subagent-runtime",
      "title": "zz subagent runtime",
      "description": "Internal shared child-Pi subagent helper library, endpoint config, and /zz-model-setup command for custom and bundled subagent extensions.",
      "entry": "extensions/00-zz-subagent-runtime.ts",
      "internal": true,
      "pluginDeps": [
        "zz-local-models"
      ],
      "fileDeps": [
        "extensions/local-model-endpoints.config.jsonc",
        "extensions/zz-agent-models.config.jsonc",
        "extensions/lib/child-agent-model-options.ts"
      ],
      "configFiles": [],
      "tags": [
        "agent",
        "runtime",
        "internal"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "zz-local-models",
      "title": "zz local models",
      "description": "Registers shared LM Studio models in Pi's normal /model picker.",
      "entry": "extensions/zzLocalModels.ts",
      "pluginDeps": [],
      "fileDeps": [
        "extensions/zzLocalModels.config.jsonc"
      ],
      "configFiles": [],
      "tags": [
        "model",
        "local-model",
        "lm-studio"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "zz-codex-proxy",
      "title": "zz Codex proxy provider",
      "description": "Registers gpt-5.6-sol through the hardened Codex proxy in Pi's normal /model picker.",
      "entry": "extensions/zzCodexProxy.ts",
      "pluginDeps": [],
      "fileDeps": [
        "extensions/zzCodexProxy.config.jsonc"
      ],
      "configFiles": [
        "extensions/zzCodexProxy.config.jsonc"
      ],
      "tags": [
        "model",
        "openai-codex",
        "telemetry"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "context-tools",
      "title": "Context tools",
      "description": "Shows context/tool usage accounting in a right-side pane.",
      "entry": "extensions/context-tools.ts",
      "pluginDeps": [
        "right-overlay-tiler"
      ],
      "fileDeps": [
        "extensions/context-tools.config.jsonc",
        "extensions/lib/right-overlay-tiler.ts"
      ],
      "configFiles": [
        "extensions/context-tools.config.jsonc"
      ],
      "tags": [
        "ui",
        "context",
        "overlay"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "git-status",
      "title": "Git status",
      "description": "Shows a VS Code-style Git branch/change summary in the footer and right-side details pane.",
      "entry": "extensions/git-status.ts",
      "pluginDeps": [
        "right-overlay-tiler"
      ],
      "fileDeps": [
        "extensions/git-status.config.jsonc",
        "extensions/lib/right-overlay-tiler.ts"
      ],
      "configFiles": [
        "extensions/git-status.config.jsonc"
      ],
      "tags": [
        "git",
        "ui",
        "overlay"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "pi-context",
      "title": "PI.md context",
      "description": "Strips built-in AGENTS.md/CLAUDE.md project context and injects discovered PI.md files instead.",
      "entry": "extensions/pi-context.ts",
      "pluginDeps": [],
      "fileDeps": [
        "extensions/pi-context.config.jsonc"
      ],
      "configFiles": [
        "extensions/pi-context.config.jsonc"
      ],
      "tags": [
        "context"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "debuggersubagent",
      "title": "Debugger subagent",
      "description": "Provides standalone diagnosis-only root-cause analysis for bugs, failures, regressions, flaky behavior, and suspicious runtime results without implementing fixes.",
      "entry": "extensions/debuggersubagent.ts",
      "pluginDeps": [
        "zz-subagent-runtime"
      ],
      "fileDeps": [
        "extensions/debuggersubagent.config.jsonc",
        "extensions/lib/child-agent-model-options.ts",
        "extensions/lib/standalone-agent-common.ts",
        "extensions/lib/standalone-parse-error.ts",
        "extensions/lib/subagent-model-preferences.ts"
      ],
      "configFiles": [],
      "tags": [
        "agent",
        "debugging",
        "subagent"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "implementationsubagent",
      "title": "Implementation subagent",
      "description": "Provides a main-agent-controlled implementation worker for one medium-to-small independently vettable piece, with a persistent ledger and a non-debug readsubagent scout/read planner; debugging is handed back to the main agent.",
      "entry": "extensions/implementationsubagent.ts",
      "pluginDeps": [
        "zz-subagent-runtime",
        "readsubagent"
      ],
      "fileDeps": [
        "extensions/implementationsubagent.config.jsonc",
        "extensions/lib/agent-mode.ts",
        "extensions/lib/child-agent-model-options.ts",
        "extensions/lib/implementation-docs.ts",
        "extensions/lib/implementation-piece.ts",
        "extensions/lib/planning-artifact-paths.ts",
        "extensions/lib/standalone-agent-common.ts",
        "extensions/lib/standalone-parse-error.ts",
        "extensions/lib/subagent-model-preferences.ts"
      ],
      "configFiles": [],
      "tags": [
        "agent",
        "implementation",
        "subagent"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "readsubagent",
      "title": "Read subagent",
      "description": "Adds /readsubagent and a readsubagent tool as a non-debug codebase scout/read planner for ordinary code, config, and documentation through a child Pi process.",
      "entry": "extensions/readsubagent.ts",
      "pluginDeps": [
        "zz-subagent-runtime",
        "zz-local-models"
      ],
      "fileDeps": [
        "extensions/readsubagent.config.jsonc",
        "extensions/local-model-endpoints.config.jsonc",
        "extensions/lib/agent-mode.ts",
        "extensions/lib/subagent-model-preferences.ts"
      ],
      "configFiles": [],
      "tags": [
        "agent",
        "read-only"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "vettingagents",
      "title": "Vetting agents",
      "description": "Runs three independent read-only adversarial child agents for docs, plans, implementation results, diffs, and code review targets.",
      "entry": "extensions/vettingagents.ts",
      "pluginDeps": [
        "zz-subagent-runtime"
      ],
      "fileDeps": [
        "extensions/vettingagents.config.jsonc",
        "extensions/local-model-endpoints.config.jsonc",
        "extensions/lib/child-agent-model-options.ts",
        "extensions/lib/agent-mode.ts",
        "extensions/lib/subagent-model-preferences.ts",
        "extensions/lib/vetting-report-format.ts"
      ],
      "configFiles": [],
      "tags": [
        "agent",
        "vetting",
        "docs"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "promptenrichsubagent",
      "title": "Prompt enrich subagent",
      "description": "Standalone prompt-enrichment agent. /pe uses readsubagent only as a non-debug scout/read planner for repo context; debugging and failures stay with direct inspection/debuggersubagent.",
      "entry": "extensions/promptenrichsubagent.ts",
      "pluginDeps": [
        "zz-subagent-runtime",
        "zz-local-models",
        "readsubagent"
      ],
      "fileDeps": [
        "extensions/promptenrichsubagent.config.jsonc",
        "extensions/local-model-endpoints.config.jsonc",
        "extensions/lib/subagent-model-preferences.ts"
      ],
      "configFiles": [],
      "tags": [
        "agent",
        "enrichment"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    },
    {
      "id": "tetris",
      "title": "Tetris",
      "description": "Adds /tetris, an overlay Tetris game for waiting during agent runs.",
      "entry": "extensions/tetris.ts",
      "pluginDeps": [],
      "fileDeps": [
        "extensions/tetris.config.jsonc"
      ],
      "configFiles": [
        "extensions/tetris.config.jsonc"
      ],
      "tags": [
        "game",
        "ui"
      ],
      "sharedDeps": [
        {
          "id": "zz-lib",
          "minVersion": "1.1.0"
        }
      ]
    }
  ]
}
